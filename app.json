{
  "expo": {
    "name": "Study-01",
    "slug": "Study-01",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "study01",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pratyush_075.Study01"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "@stream-io/video-react-native-sdk",
        [
          "@config-plugins/react-native-webrtc",
          {
            // add your explanations for camera and microphone
            "cameraPermission": "$(PRODUCT_NAME) requires camera access in order to capture and transmit video",
            "microphonePermission": "$(PRODUCT_NAME) requires microphone access in order to capture and transmit audio"
          }
        ]
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "study-01",
          "organization": "none-4nu"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "${PRODUCT_NAME} would like to access your camera to share image in a message",
          "photoPermission": "${PRODUCT_NAME} would like to access your photo library to share image in a message"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "{PRODUCT_NAME} would like to access your microphone to share audio in a message"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ebd71a9-a0f6-44f4-a504-98e070acd7e2"
      }
    }
  }
}
